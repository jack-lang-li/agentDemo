<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>
    <groupId>com.example.agent</groupId>
    <artifactId>spring-agent-learning</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>spring-agent-learning</name>
    <description>模型与业务能力的 Maven 多模块父工程</description>
    <modules>
        <module>common-core</module>
        <module>common-web</module>
        <module>llm-api</module>
        <module>llm-client</module>
        <module>agent-core</module>
        <module>llm-provider-responses</module>
        <module>llm-service</module>
        <module>business-service</module>
    </modules>
    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>
    <!-- 只管理版本，各模块按实际使用显式声明依赖。 -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.example.agent</groupId>
                <artifactId>common-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example.agent</groupId>
                <artifactId>common-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example.agent</groupId>
                <artifactId>llm-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example.agent</groupId>
                <artifactId>llm-client</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example.agent</groupId>
                <artifactId>agent-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example.agent</groupId>
                <artifactId>llm-provider-responses</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example.agent</groupId>
                <artifactId>llm-service</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example.agent</groupId>
                <artifactId>business-service</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <id>module-boundaries</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <!-- 启动应用不能作为任何模块的类库依赖，测试也不例外。 -->
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>com.example.agent:business-service</exclude>
                                        <exclude>com.example.agent:llm-service</exclude>
                                    </excludes>
                                    <searchTransitive>true</searchTransitive>
                                    <message>启动服务不能被其他模块依赖，请使用契约或组件模块。</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
